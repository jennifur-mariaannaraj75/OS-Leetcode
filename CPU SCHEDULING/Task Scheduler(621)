import java.util.Arrays;

class Solution {
    public int leastInterval(char[] tasks, int n) {
        int[] freq = new int[26];
        for (char task : tasks) {
            freq[task - 'A']++;
        }
        
        Arrays.sort(freq);
        
   
        int max = freq[25];
        int idleSlots = (max - 1) * n; 

      
        for (int i = 24; i >= 0 && freq[i] > 0; i--) {
            idleSlots -= Math.min(max - 1, freq[i]);
        }
        
       
        return idleSlots > 0 ? tasks.length + idleSlots : tasks.length;
    }
}
Input
tasks =
["A","A","A","B","B","B"]
n =
2
Output
8
Expected
8
